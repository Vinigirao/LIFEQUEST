# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# URL pública do app (sem barra no final)
NEXT_PUBLIC_SITE_URL=https://seu-app.vercel.app

# Push (gere com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Senha que o agendador do Supabase usa para chamar /api/cron/reminders
CRON_SECRET=

# Strava → https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Qualquer texto aleatório; usado para validar o webhook
STRAVA_WEBHOOK_VERIFY_TOKEN=

# Versão beta sem login (opcionais)
# E-mail da sua conta no Supabase. Se vazio, o app usa o primeiro usuário (ou cria um).
OWNER_EMAIL=
# Se preencher, o app só abre em aparelhos que visitarem uma vez https://seu-app.vercel.app/?chave=ESTE_VALOR
APP_ACCESS_KEY=
